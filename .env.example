HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DESCRIPTIONS_ENABLED=true
# Comma-separated addresses/CIDRs of reverse proxies allowed to set the client IP.
# TRUST_PROXY=127.0.0.1,::1
# Replace both placeholders with the same generated local password.
POSTGRES_PASSWORD=replace-with-generated-password
DATABASE_URL=postgresql://animals:replace-with-generated-password@127.0.0.1:5433/animals
