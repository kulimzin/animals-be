{
  "name": "animals-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "node --env-file=.env.test node_modules/vitest/vitest.mjs run --project integration",
    "check": "npm run build && npm run lint && npm test",
    "db:up": "docker compose up -d --wait db",
    "db:test:up": "docker compose --env-file .env.test --profile test up -d --wait db-test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
