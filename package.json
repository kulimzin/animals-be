{
  "name": "animals-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "node --env-file=.env.test node_modules/vitest/vitest.mjs run --project integration",
    "openapi:export": "node --import tsx scripts/export-openapi.ts",
    "openapi:check": "node --import tsx scripts/export-openapi.ts --check",
    "check": "npm run build && npm run lint && npm test",
    "db:up": "docker compose up -d --wait db",
    "db:test:up": "docker compose --env-file .env.test --profile test up -d --wait db-test",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/infrastructure/database/migrate.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
